modules = ["python-3.12"]
run = "pip install -q -r requirements.txt && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"

[deployment]
build = ["sh", "-c", "pip install -q -r requirements.txt"]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80
