modules = ["python-3.12"]
run = "pip install -q -r requirements.txt && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"

[deployment]
build = ["sh", "-c", "pip install -q -r requirements.txt"]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATABASE_URL=sqlite:///./sejukguard.db uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000
